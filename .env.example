# ═══════════════════════════════════════════════════════════════════
# Return Saver — 环境配置模板
# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 里，永远不要提交
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────── 运行环境
RS_ENV=dev                       # dev | staging | prod
RS_PORT=8777
# 签发 offer_token 的 HMAC 密钥。生产必须换成随机值：openssl rand -hex 32
RS_SIGNING_KEY=dev-only-not-a-real-secret

# ───────────────────────────────── LLM 接入（OpenAI 兼容端点）
# 默认智谱 GLM。换任何 OpenAI 兼容厂商只改下面三行 + 模型名
RS_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
RS_LLM_API_KEY=
# 兼容别名：若只设了 GLM_API_KEY / GLM_BASE_URL 也能被读到
GLM_API_KEY=
GLM_BASE_URL=

# 三档模型。意图识别只用小模型，生成侧按情绪/客单/轮次动态路由
RS_MODEL_INTENT=glm-4.5-air      # 意图 + 情绪分类（关思考链，实测 41 out-tokens）
RS_MODEL_SMALL=glm-5-turbo       # 常规挽留话术（关思考链，实测 15 out-tokens）
RS_MODEL_LARGE=glm-4.6           # 高情绪 / 高客单 / 二轮僵持

# 单次会话 LLM 成本硬预算（USD），超出强制降档到确定性模板
# 推理模型会把 max_tokens 烧在 reasoning 上导致 content 为空，必须留足
RS_MAX_TOKENS_INTENT=256
RS_MAX_TOKENS_SMALL=512
RS_MAX_TOKENS_LARGE=1024

# 思考链开关。三档一律关：分类开着 5.8x token；生成开着延迟翻倍(19-22s vs 9-10s)
# 而话术质量几乎无差别。挽留话术只有 2-3 句，不是需要推理的任务。
RS_THINKING_INTENT=false
RS_THINKING_SMALL=false
RS_THINKING_LARGE=false
# 聊天窗口延迟预算（秒）；超了用户直接关窗，比话术差一点严重得多
RS_LATENCY_BUDGET=12

RS_COST_BUDGET=0.05

# ───────────────────────────────── Langfuse 可观测性
# 不填则自动关闭，全部埋点变 no-op，服务照常运行
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com | 自托管填自己的
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=dev # Langfuse 里的环境标签，和 RS_ENV 对齐
RS_LANGFUSE_SAMPLE_RATE=1.0      # 生产可降到 0.2 控成本；护栏触发的 trace 永远全采

# ───────────────────────────────── PostgreSQL
# MVP 默认 memory（进程内），上线切 postgres
RS_STORE_BACKEND=memory          # memory | postgres
DATABASE_URL=postgresql://returnsaver:returnsaver@localhost:5432/returnsaver
RS_DB_POOL_MIN=1
RS_DB_POOL_MAX=10
RS_DB_CONNECT_TIMEOUT=5
# 建表：psql "$DATABASE_URL" -f db/schema.sql

# ───────────────────────────────── 策略与体验阈值
RS_MAX_NEGOTIATION_ROUNDS=2      # 最多谈几轮，之后无条件放行退货
RS_MAX_SESSION_TURNS=8
RS_MAX_DISCOUNT_PCT=0.30         # 任何让利 ≤ 订单金额的比例上限
RS_INSTANT_REFUND_CAP=50         # 情绪激烈 + 金额 ≤ 此值 → 立即退款
RS_MANUAL_SLA_HOURS=2            # 转人工的响应时效承诺
RS_EMOTION_HARD_STOP=0.70        # ≥ 此值禁止再挽留
RS_EMOTION_LARGE_MODEL=0.45      # ≥ 此值生成侧升大模型
RS_HIGH_VALUE_ORDER=200          # ≥ 此金额生成侧升大模型
RS_OFFER_TOKEN_TTL=900

# ───────────────────────────────── 实验
RS_HOLDOUT_PCT=0                 # 生产置 10：对照组，用于挽留效果的增量归因
